# Copy this file to ".env" and fill in your own values
PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/nexusgpt

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# AI providers: set at least one. Models for a provider only appear
# in the dropdown when its key is set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Email (verification + password reset) ----
# Where your frontend runs. Used to build the links inside emails.
CLIENT_URL=http://localhost:5173

# Leave SMTP_HOST empty in development: emails are printed in this terminal instead of being sent.
# For real emails fill these in (Gmail, Brevo, Mailgun, Resend, ... all offer SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NexusGPT <no-reply@yourdomain.com>"

# true = people must verify their email before they can log in (use this in production with SMTP)
REQUIRE_EMAIL_VERIFICATION=false

# ---- Optional / deployment ----
# Only allow this website to call the API (comma-separated). Empty = allow all (fine for local dev).
CLIENT_ORIGIN=
# Set to 1 when the API runs behind a reverse proxy (nginx, Render, Railway, ...)
TRUST_PROXY=

# Login/signup attempts allowed per IP per 15 minutes (default 30) and
# email-sending requests (forgot password / resend) per IP per 15 minutes (default 5)
AUTH_RATE_LIMIT=
EMAIL_RATE_LIMIT=
